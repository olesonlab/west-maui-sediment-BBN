			<state id="MultipleDisturbance" />
			<state id="Undisturbed" />
			<probabilities>0.15 0.1 0.05 0.7</probabilities>
		</cpt>
		<cpt id="FillTerrace">
			<state id="FillTerracePresent" />
			<state id="FillTerraceAbsent" />
